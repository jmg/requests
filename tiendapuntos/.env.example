# PostgreSQL — cadena de conexión de Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tiendapuntos?schema=public"

# Secreto para firmar los JWT de sesión (poné una cadena larga y aleatoria)
AUTH_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# URL pública de la app (para links de invitación, QR y redirecciones de Stripe)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Dominio raíz para subdominios por negocio (ej: tuapp.com).
# En local podés usar lvh.me (apunta a 127.0.0.1): NEXT_PUBLIC_ROOT_DOMAIN="lvh.me:3000"
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"

# Stripe (opcional). Si no se configuran, el upgrade a Pro funciona en modo simulado.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO=""

# Mercado Pago (opcional). Con el access token se habilita el pago con Checkout Pro.
MP_ACCESS_TOKEN=""
MP_PRO_PRICE="15000"
